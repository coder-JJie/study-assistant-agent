# ===== 复制本文件为 .env 后填写 =====
# LLM API 配置（任何 OpenAI 兼容接口均可：DeepSeek / 通义 / Kimi / 智谱…）

# 必填：你的 API Key（不填也能跑，agent 会退回 mock 演示模式）
LLM_API_KEY=sk-d3236007010876a34d8782b8bee72753bf112186a2381ae0

# 接口地址（DeepSeek 示例；通义改 https://dashscope.aliyuncs.com/compatible-mode/v1）
LLM_API_BASE=https://myai.bupt.edu.cn/llm-gw/v1

# 模型名（DeepSeek 用 deepseek-chat；通义用 qwen-plus 等）
LLM_MODEL=deepseek-v4-flash

# 编排循环最多允许的工具调用轮数
AGENT_MAX_ROUNDS=6
